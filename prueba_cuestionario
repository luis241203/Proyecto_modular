import tkinter as tk
from tkinter import messagebox, scrolledtext

class CuestionarioUnaPagina:
    def __init__(self, root):
        self.root = root
        self.root.title("Cuestionario de Respuestas Abiertas")
        self.root.geometry("900x700")
        
        # Lista de preguntas
        self.preguntas = [
            "1. ¿Cuáles son tus metas profesionales a corto plazo?",
            "2. Describe una situación difícil que hayas superado y qué aprendiste de ella.",
            "3. ¿Qué habilidades crees que son más importantes para tu desarrollo profesional?",
            "4. ¿Cómo te ves dentro de 5 años?",
            "5. ¿Qué te motiva a mejorar cada día?"
        ]
        
        # Configurar la interfaz
        self.crear_interfaz()
    
    def crear_interfaz(self):
        # Frame principal con scrollbar
        self.main_frame = tk.Frame(self.root)
        self.main_frame.pack(fill=tk.BOTH, expand=True)
        
        # Canvas para el scroll
        self.canvas = tk.Canvas(self.main_frame)
        self.canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        # Scrollbar
        scrollbar = tk.Scrollbar(self.main_frame, command=self.canvas.yview)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        self.canvas.configure(yscrollcommand=scrollbar.set)
        
        # Frame interno para los widgets
        self.inner_frame = tk.Frame(self.canvas)
        self.canvas.create_window((0, 0), window=self.inner_frame, anchor=tk.NW)
        
        # Configurar el evento de redimensionamiento
        self.inner_frame.bind(
            "<Configure>",
            lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all"))
        )
        
        # Título
        titulo = tk.Label(
            self.inner_frame,
            text="Cuestionario de Respuestas Abiertas",
            font=("Arial", 16, "bold"),
            pady=20
        )
        titulo.pack()
        
        # Instrucciones
        instrucciones = tk.Label(
            self.inner_frame,
            text="Por favor, responde a cada una de las siguientes preguntas con el mayor detalle posible:",
            font=("Arial", 11),
            wraplength=800,
            justify=tk.LEFT,
            pady=10
        )
        instrucciones.pack()
        
        # Crear campos para cada pregunta
        self.respuestas_widgets = []
        for i, pregunta in enumerate(self.preguntas):
            frame_pregunta = tk.Frame(self.inner_frame, pady=15)
            frame_pregunta.pack(fill=tk.X)
            
            # Etiqueta de la pregunta
            lbl_pregunta = tk.Label(
                frame_pregunta,
                text=pregunta,
                font=("Arial", 12, "bold"),
                wraplength=800,
                justify=tk.LEFT
            )
            lbl_pregunta.pack(anchor=tk.W)
            
            # Área de texto para la respuesta
            respuesta = scrolledtext.ScrolledText(
                frame_pregunta,
                width=100,
                height=5,
                wrap=tk.WORD,
                font=("Arial", 11),
                padx=10,
                pady=10
            )
            respuesta.pack(fill=tk.X)
            self.respuestas_widgets.append(respuesta)
        
        # Botón de enviar
        btn_frame = tk.Frame(self.inner_frame, pady=30)
        btn_frame.pack()
        
        btn_enviar = tk.Button(
            btn_frame,
            text="Enviar Cuestionario",
            command=self.enviar_respuestas,
            font=("Arial", 12),
            bg="#4CAF50",
            fg="white",
            padx=20,
            pady=10
        )
        btn_enviar.pack()
    
    def enviar_respuestas(self):
        respuestas = []
        for i, widget in enumerate(self.respuestas_widgets):
            respuesta = widget.get("1.0", tk.END).strip()
            if not respuesta:
                messagebox.showwarning("Advertencia", f"Por favor, responde a la pregunta {i+1}")
                return
            
            respuestas.append({
                "pregunta": self.preguntas[i],
                "respuesta": respuesta
            })
        
        # Aquí puedes procesar las respuestas (guardar en archivo, base de datos, etc.)
        self.mostrar_resumen(respuestas)
    
    def mostrar_resumen(self, respuestas):
        # Crear ventana de resumen
        resumen_win = tk.Toplevel(self.root)
        resumen_win.title("Resumen de Respuestas")
        resumen_win.geometry("800x600")
        
        # Frame con scroll
        frame = tk.Frame(resumen_win)
        frame.pack(fill=tk.BOTH, expand=True)
        
        canvas = tk.Canvas(frame)
        canvas.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        
        scrollbar = tk.Scrollbar(frame, command=canvas.yview)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        canvas.configure(yscrollcommand=scrollbar.set)
        
        inner_frame = tk.Frame(canvas)
        canvas.create_window((0, 0), window=inner_frame, anchor=tk.NW)
        
        inner_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        
        # Título
        tk.Label(
            inner_frame,
            text="Tus respuestas:",
            font=("Arial", 14, "bold"),
            pady=20
        ).pack()
        
        # Mostrar preguntas y respuestas
        for item in respuestas:
            tk.Label(
                inner_frame,
                text=item["pregunta"],
                font=("Arial", 12, "bold"),
                wraplength=700,
                justify=tk.LEFT
            ).pack(anchor=tk.W, pady=(10, 0))
            
            tk.Label(
                inner_frame,
                text=item["respuesta"],
                font=("Arial", 11),
                wraplength=700,
                justify=tk.LEFT,
                bg="#F0F0F0",
                padx=10,
                pady=10
            ).pack(anchor=tk.W, fill=tk.X, pady=(0, 20))
        
        # Botón para cerrar
        tk.Button(
            inner_frame,
            text="Cerrar",
            command=resumen_win.destroy,
            pady=10,
            padx=20
        ).pack(pady=20)

if __name__ == "__main__":
    root = tk.Tk()
    app = CuestionarioUnaPagina(root)
    root.mainloop()